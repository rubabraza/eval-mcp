# Which LLM provider to use for run_eval outputs and the LLM judge layer.
# Options: mock (default, offline), ollama, gemini, anthropic
EVAL_PROVIDER=mock

# --- Ollama (local, free) --- https://ollama.com
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Google Gemini (free tier) --- https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Anthropic (optional; run: uv add anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
